# Resend API Key (Required)
# Generate one in your Resend Dashboard: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here

# Recipient Email for Enquiries (Optional, defaults to concierge@ironforgefitness.com)
# When testing with unverified Resend domain, this MUST be the email address of your Resend account
ADMIN_EMAIL=mithunmessi39@gamil.com

# Verified Sender Email (Optional, defaults to onboarding@resend.dev)
# Once you verify your custom domain in Resend, set this to e.g. "IRONFORGE Concierge <contact@yourdomain.com>"
RESEND_FROM_EMAIL=IRONFORGE Concierge <onboarding@resend.dev>
